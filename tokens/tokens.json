{
  "$description": "توکن‌های طراحی سیمرغ — منبع اصلی حقیقت (Single Source of Truth)",
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "simorgh": {
    "color": {
      "primary": {
        "50": { "$type": "color", "$value": "TBD" },
        "100": { "$type": "color", "$value": "TBD" },
        "500": { "$type": "color", "$value": "TBD" },
        "700": { "$type": "color", "$value": "TBD" },
        "900": { "$type": "color", "$value": "TBD" }
      },
      "neutral": {
        "0": { "$type": "color", "$value": "#ffffff" },
        "100": { "$type": "color", "$value": "TBD" },
        "500": { "$type": "color", "$value": "TBD" },
        "900": { "$type": "color", "$value": "TBD" }
      },
      "semantic": {
        "success": { "$type": "color", "$value": "TBD" },
        "warning": { "$type": "color", "$value": "TBD" },
        "danger": { "$type": "color", "$value": "TBD" },
        "info": { "$type": "color", "$value": "TBD" }
      }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "0.25rem" },
      "2": { "$type": "dimension", "$value": "0.5rem" },
      "3": { "$type": "dimension", "$value": "0.75rem" },
      "4": { "$type": "dimension", "$value": "1rem" },
      "6": { "$type": "dimension", "$value": "1.5rem" },
      "8": { "$type": "dimension", "$value": "2rem" },
      "12": { "$type": "dimension", "$value": "3rem" },
      "16": { "$type": "dimension", "$value": "4rem" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "TBD" },
      "md": { "$type": "dimension", "$value": "TBD" },
      "lg": { "$type": "dimension", "$value": "TBD" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "font": {
      "family": {
        "fa": { "$type": "fontFamily", "$value": "TBD" },
        "latin": { "$type": "fontFamily", "$value": "TBD" },
        "mono": { "$type": "fontFamily", "$value": "TBD" }
      },
      "size": {
        "display": { "$type": "dimension", "$value": "TBD" },
        "h1": { "$type": "dimension", "$value": "TBD" },
        "h2": { "$type": "dimension", "$value": "TBD" },
        "body": { "$type": "dimension", "$value": "1rem" },
        "caption": { "$type": "dimension", "$value": "0.875rem" }
      }
    },
    "shadow": {
      "sm": { "$type": "shadow", "$value": "TBD" },
      "md": { "$type": "shadow", "$value": "TBD" },
      "lg": { "$type": "shadow", "$value": "TBD" }
    }
  }
}
